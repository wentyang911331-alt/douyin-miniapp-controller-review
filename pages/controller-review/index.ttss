.app {
  min-height: 100vh;
  background: #0E1623;
  color: #EDF1F8;
  --bg: #0E1623;
  --panel: #18212F;
  --panel-2: #232E40;
  --panel-raise: #1D2735;
  --border: rgba(255, 255, 255, 0.08);
  --border-soft: rgba(255, 255, 255, 0.05);
  --text: #EDF1F8;
  --muted: #93A0B5;
  --dim: #6B7689;
  --icon-dim: #93A0B5;
  --accent: #5E7BFF;
  --accent-strong: #4862E0;
  --accent-bg: rgba(94, 123, 255, 0.14);
  --accent-text: #ffffff;
  --success: #10B981;
  --warning: #F59E0B;
  --danger: #EF4444;
  --ref-bg: rgba(255, 255, 255, 0.04);
  --backdrop: rgba(4, 8, 16, 0.62);
  position: relative;
}

button {
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
  color: inherit;
  font-family: inherit;
  line-height: 1;
}

button::after {
  border: 0;
}

.app.light {
  background: #F4F6FA;
  color: #0F172A;
  --bg: #F4F6FA;
  --panel: #ffffff;
  --panel-2: #EEF1F6;
  --panel-raise: #ffffff;
  --border: #DBE0EA;
  --border-soft: #EAEEF4;
  --text: #0F172A;
  --muted: #5B6677;
  --dim: #8A93A3;
  --icon-dim: #5B6677;
  --accent: #3B54D6;
  --accent-strong: #2A40B5;
  --accent-bg: rgba(59, 84, 214, 0.10);
  --accent-text: #ffffff;
  --success: #059669;
  --warning: #D97706;
  --danger: #DC2626;
  --ref-bg: rgba(91, 102, 119, 0.06);
  --backdrop: rgba(16, 23, 34, 0.42);
}

.watermark {
  position: fixed;
  left: -150rpx;
  top: 130rpx;
  width: 1160rpx;
  height: 1500rpx;
  z-index: 0;
  display: flex;
  flex-wrap: wrap;
  gap: 71rpx 105rpx;
  transform: rotate(-22deg);
  pointer-events: none;
  overflow: hidden;
}

.watermark-item {
  color: rgba(255, 255, 255, 0.04);
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1;
  white-space: nowrap;
}

.light .watermark-item {
  color: rgba(15, 23, 42, 0.045);
}

.topbar {
  position: relative;
  z-index: 2;
  padding: 22rpx 26rpx 15rpx;
  background: linear-gradient(180deg, #1A2433 0%, #18212F 100%);
  border-bottom: 2rpx solid var(--border);
}

.light .topbar {
  background: var(--panel);
}

.topline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15rpx;
  margin-bottom: 19rpx;
}

.title {
  min-width: 0;
  flex: 1;
  color: var(--text);
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.18;
}

.tool-row,
.section-actions,
.view-row,
.rank-tools {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.tool-row {
  flex-shrink: 0;
}

.icon-btn {
  width: 60rpx;
  height: 60rpx;
  min-width: 60rpx;
  border-radius: 19rpx;
  border: 2rpx solid var(--border);
  background: var(--panel-2);
  display: flex;
  align-items: center;
  justify-content: center;
}

.section-icon-btn {
  width: 49rpx;
  height: 49rpx;
  min-width: 49rpx;
  border-radius: 16rpx;
  background: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-btn.active {
  border-color: var(--accent);
  background: var(--accent-bg);
}

.section-icon-btn.active {
  color: var(--accent);
  background: var(--accent-bg);
}

.icon-img {
  width: 40rpx;
  height: 40rpx;
}

.inline-img {
  width: 26rpx;
  height: 26rpx;
  flex-shrink: 0;
}

.section-icon-btn .icon-img {
  width: 30rpx;
  height: 30rpx;
  opacity: 0.85;
}

.icon-btn.active .icon-img,
.section-icon-btn.active .icon-img,
.sort-chip.active .inline-img {
  opacity: 1;
}

.sort-img {
  width: 24rpx;
  height: 24rpx;
  margin-left: 6rpx;
  flex-shrink: 0;
}

.nav-row,
.chip-row {
  white-space: nowrap;
  width: 100%;
}

.nav-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 128rpx;
  height: 49rpx;
  margin-right: 11rpx;
  border-radius: 15rpx;
  background: var(--panel-2);
  color: var(--muted);
  font-size: 22rpx;
  font-weight: 700;
}

.nav-btn.active {
  background: var(--accent);
  color: var(--accent-text);
}

.highlight-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 19rpx 0 11rpx;
}

.highlight-label {
  color: var(--muted);
  font-size: 21rpx;
  font-weight: 700;
}

.clear-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  color: var(--muted);
  font-size: 21rpx;
}

.chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 49rpx;
  margin-right: 11rpx;
  padding: 0 19rpx;
  border-radius: 24rpx;
  border: 2rpx solid var(--border);
  background: var(--panel-2);
  color: var(--muted);
  font-size: 22rpx;
  font-weight: 600;
}

.chip.ref {
  border-style: dashed;
}

.content {
  position: relative;
  z-index: 1;
  height: calc(100vh - 250rpx);
  padding: 26rpx 22rpx 0;
  box-sizing: border-box;
}

.section {
  margin-bottom: 41rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 19rpx;
  margin-bottom: 19rpx;
}

.title-group {
  display: flex;
  align-items: center;
  gap: 11rpx;
  min-width: 0;
}

.section-title {
  color: var(--text);
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.3;
}

.note {
  display: block;
  margin: 0 0 19rpx;
  color: var(--muted);
  font-size: 21rpx;
  line-height: 1.6;
}

.col-panel,
.table-card,
.rank-card {
  background: var(--panel);
  border: 2rpx solid var(--border);
  border-radius: 26rpx;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.40), 0 11rpx 38rpx rgba(0, 0, 0, 0.28);
}

.light .col-panel,
.light .table-card,
.light .rank-card {
  box-shadow: 0 2rpx 4rpx rgba(15, 23, 42, 0.04), 0 8rpx 30rpx rgba(15, 23, 42, 0.06);
}

.col-panel {
  padding: 22rpx;
  margin-bottom: 19rpx;
}

.col-title {
  display: block;
  color: var(--muted);
  font-size: 21rpx;
  font-weight: 700;
  margin-bottom: 15rpx;
}

.col-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 11rpx;
}

.col-chip,
.sort-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 45rpx;
  min-height: 45rpx;
  padding: 0 19rpx;
  border-radius: 999rpx;
  border: 2rpx solid var(--border);
  background: var(--panel-2);
  color: var(--muted);
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1;
  box-sizing: border-box;
  white-space: nowrap;
}

.col-chip.on,
.sort-chip.active {
  border-color: var(--accent);
  background: var(--accent);
  color: var(--accent-text);
  font-weight: 700;
}

.view-row {
  margin-bottom: 19rpx;
  flex-wrap: wrap;
}

.seg {
  display: flex;
  padding: 4rpx;
  border: 2rpx solid var(--border);
  border-radius: 19rpx;
  background: var(--panel-2);
}

.seg-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  height: 45rpx;
  padding: 0 19rpx;
  border-radius: 13rpx;
  background: transparent;
  color: var(--muted);
  font-size: 22rpx;
  font-weight: 700;
}

.seg-btn.active {
  background: var(--accent);
  color: var(--accent-text);
}

.rank-tools {
  flex: 1;
  min-width: 0;
  flex-wrap: nowrap;
}

.rank-col-scroll {
  max-width: 315rpx;
  white-space: nowrap;
}

.sort-chip {
  margin-right: 11rpx;
}

.sort-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  height: 49rpx;
  min-width: 120rpx;
  padding: 0 19rpx;
  border-radius: 19rpx;
  border: 2rpx solid var(--border);
  background: var(--panel-2);
  color: var(--text);
  font-size: 22rpx;
  font-weight: 700;
  white-space: nowrap;
  flex-shrink: 0;
}

.hint {
  color: var(--muted);
  font-size: 21rpx;
}

.table-card {
  overflow: hidden;
  white-space: nowrap;
}

.table {
  min-width: 100%;
}

.tr {
  display: flex;
  min-height: 75rpx;
}

.th-row {
  background: var(--panel-2);
}

.cell {
  width: 210rpx;
  min-width: 210rpx;
  padding: 19rpx 22rpx;
  box-sizing: border-box;
  border-top: 2rpx solid var(--border-soft);
  color: var(--text);
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1.3;
  white-space: nowrap;
  display: flex;
  align-items: center;
}

.head-cell,
.model-head {
  border-top: 0;
  background: var(--panel-2);
  color: var(--muted);
  font-size: 22rpx;
  font-weight: 700;
}

.head-cell {
  display: flex;
  align-items: center;
  text-align: left;
  position: relative;
  z-index: 1;
}

.head-cell.sortable {
  color: var(--muted);
}

.head-cell.sorted {
  color: var(--accent);
}

.model-cell {
  position: sticky;
  left: 0;
  z-index: 5;
  width: 250rpx;
  min-width: 250rpx;
  border-right: 2rpx solid var(--border);
  border-left: 6rpx solid transparent;
  background: var(--panel);
  font-weight: 700;
}

.model-head {
  z-index: 6;
  background: var(--panel-2);
}

.data-cell {
  position: relative;
  z-index: 0;
}

.model-cell.ref {
  border-left-style: dashed;
}

.model-inline {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
  white-space: normal;
  word-break: break-word;
}

.rank-badge,
.best-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 8rpx;
  font-weight: 800;
  line-height: 1.2;
}

.rank-badge {
  min-width: 41rpx;
  padding: 2rpx 9rpx;
  background: var(--panel-2);
  color: var(--muted);
  font-size: 19rpx;
  border: 2rpx solid var(--border-soft);
}

.rank-badge.first,
.best-badge {
  background: var(--accent);
  color: var(--accent-text);
}

.best-badge {
  margin-left: 8rpx;
  padding: 2rpx 11rpx;
  font-size: 19rpx;
  border-radius: 999rpx;
}

.data-cell.strong {
  font-weight: 800;
}

.data-cell.long {
  white-space: normal;
  word-break: break-word;
  line-height: 1.35;
}

.good {
  color: var(--success);
}

.warn {
  color: var(--warning);
}

.bad {
  color: var(--danger);
}

.rank-card {
  padding: 26rpx 26rpx 8rpx;
}

.rank-item {
  padding: 19rpx 4rpx;
  border-bottom: 2rpx solid var(--border-soft);
}

.rank-item.last {
  border-bottom: 0;
}

.rank-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 19rpx;
  margin-bottom: 15rpx;
}

.rank-name {
  display: flex;
  align-items: center;
  gap: 15rpx;
  min-width: 0;
  flex: 1;
}

.rank-number {
  width: 45rpx;
  height: 45rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  flex-shrink: 0;
  color: var(--muted);
  background: var(--panel-2);
  border-radius: 11rpx;
  font-size: 21rpx;
  font-weight: 800;
}

.rank-number.first {
  background: var(--accent);
  color: var(--accent-text);
}

.rank-product {
  border-left: 6rpx solid transparent;
  padding-left: 15rpx;
  color: var(--text);
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.2;
}

.rank-value {
  color: var(--text);
  font-size: 24rpx;
  font-weight: 800;
  white-space: nowrap;
}

.bar {
  position: relative;
  height: 11rpx;
  margin-left: 60rpx;
  background: var(--panel-2);
  border-radius: 999rpx;
  overflow: visible;
}

.bar-fill {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  border-radius: 999rpx;
}

.avg-line {
  position: absolute;
  top: -6rpx;
  bottom: -6rpx;
  width: 2rpx;
  background: var(--muted);
  opacity: 0.5;
}

.avg-note {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 15rpx;
  padding-left: 60rpx;
  color: var(--dim);
  font-size: 21rpx;
}

.avg-mark {
  width: 20rpx;
  height: 2rpx;
  background: var(--muted);
  opacity: 0.5;
}

.ref-block {
  margin-top: 15rpx;
  padding: 19rpx 4rpx 4rpx;
  border-top: 2rpx dashed var(--border);
  opacity: 0.85;
}

.ref-label {
  display: block;
  margin: 0 0 8rpx 60rpx;
  color: var(--dim);
  font-size: 21rpx;
}

.ref-product {
  color: var(--muted);
  border-left-style: dashed;
  border-left-color: var(--dim);
}

.ref-value {
  color: var(--muted);
}

.ref-fill {
  background: var(--dim);
  opacity: 0.65;
}

.footer {
  margin: 38rpx 0 45rpx;
  padding: 22rpx;
  color: var(--dim);
  font-size: 21rpx;
  line-height: 1.6;
  text-align: center;
}

.modal-layer {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 41rpx 30rpx;
  box-sizing: border-box;
}

.modal-backdrop {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: var(--backdrop);
  backdrop-filter: blur(6px);
  -webkit-backdrop-filter: blur(6px);
}

.light .modal-backdrop {
  background: var(--backdrop);
}

.info-modal {
  position: relative;
  z-index: 1;
  width: 100%;
  max-width: 638rpx;
  max-height: 78vh;
  padding: 30rpx;
  border: 2rpx solid var(--border);
  border-radius: 26rpx;
  background: var(--panel);
  box-shadow: 0 45rpx 112rpx rgba(0, 0, 0, 0.48);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.light .info-modal {
  box-shadow: 0 34rpx 90rpx rgba(15, 23, 42, 0.18);
}

.info-modal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 22rpx;
  padding-bottom: 19rpx;
  border-bottom: 2rpx solid var(--border-soft);
}

.info-modal-title {
  color: var(--text);
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.25;
}

.modal-close {
  width: 52rpx;
  height: 52rpx;
  min-width: 52rpx;
  border-radius: 15rpx;
  border: 2rpx solid var(--border);
  background: var(--panel-2);
  display: flex;
  align-items: center;
  justify-content: center;
}

.info-modal-body {
  flex: 1;
  min-height: 0;
  max-height: 48vh;
  padding: 22rpx 0 8rpx;
  overflow-y: auto;
}

.info-intro,
.info-note {
  display: block;
  color: var(--muted);
  font-size: 24rpx;
  line-height: 1.6;
}

.info-intro {
  margin-bottom: 19rpx;
}

.info-point {
  display: flex;
  align-items: flex-start;
  gap: 15rpx;
  margin-bottom: 15rpx;
}

.info-dot {
  width: 11rpx;
  height: 11rpx;
  margin-top: 13rpx;
  border-radius: 999rpx;
  background: var(--accent);
  flex-shrink: 0;
}

.info-point-text {
  flex: 1;
  min-width: 0;
  color: var(--text);
  font-size: 24rpx;
  line-height: 1.6;
}

.info-note {
  margin-top: 19rpx;
  padding: 19rpx;
  border-radius: 19rpx;
  border-top: 0;
  background: var(--ref-bg);
}

.modal-ok {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 263rpx;
  height: 68rpx;
  margin: 22rpx auto 0;
  border-radius: 999rpx;
  background: var(--accent);
  color: var(--accent-text);
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1;
  box-shadow: 0 11rpx 30rpx -8rpx var(--accent-bg);
}

.mt-loading {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 90;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--backdrop);
  backdrop-filter: blur(2px);
  -webkit-backdrop-filter: blur(2px);
}

.mt-loading.mt-enter {
  animation: mt-scrim-in 200ms ease-out both;
}

.mt-loading.is-leaving {
  animation: mt-scrim-out 260ms ease-in both;
}

.mt-card {
  position: relative;
  width: 230rpx;
  height: 230rpx;
  border-radius: 45rpx;
  border: 2rpx solid var(--border);
  background: rgba(29, 39, 53, 0.72);
  box-shadow: 0 45rpx 112rpx rgba(0, 0, 0, 0.48);
  backdrop-filter: blur(20px) saturate(1.3);
  -webkit-backdrop-filter: blur(20px) saturate(1.3);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 28rpx;
  overflow: hidden;
}

.light .mt-card {
  background: rgba(255, 255, 255, 0.78);
  box-shadow: 0 34rpx 90rpx rgba(15, 23, 42, 0.18);
}

.mt-loading.mt-enter .mt-card {
  animation: mt-card-in 280ms cubic-bezier(0.2, 0.8, 0.25, 1) both;
}

.mt-loading.is-leaving .mt-card {
  animation: mt-card-out 220ms ease-in both;
}

.mt-logo-mark {
  position: relative;
  width: 108rpx;
  height: 64rpx;
  overflow: visible;
}

.mt-logo-canvas {
  position: absolute;
  left: 0;
  top: 0;
  width: 108rpx;
  height: 64rpx;
  opacity: 0;
}

.mt-logo-canvas.ready {
  opacity: 1;
}

.mt-logo-fallback {
  position: absolute;
  left: 7rpx;
  top: -4rpx;
  width: 94rpx;
  height: 72rpx;
}

.mt-stroke {
  position: absolute;
  height: 10rpx;
  border-radius: 999rpx;
  background: var(--accent);
  transform-origin: left center;
}

.mt-stroke-one {
  left: 7rpx;
  top: 48rpx;
  width: 66rpx;
  transform: rotate(-49deg) scaleX(1);
}

.mt-stroke-two {
  left: 41rpx;
  top: 48rpx;
  width: 60rpx;
  transform: rotate(-49deg) scaleX(1);
}

.mt-stroke-three {
  left: 78rpx;
  top: 16rpx;
  width: 22rpx;
  transform: scale(1);
  transform-origin: 20% 80%;
}

.mt-loading.is-drawing .mt-stroke-one {
  animation: mt-stroke-one 340ms ease-in-out 60ms both;
}

.mt-loading.is-drawing .mt-stroke-two {
  animation: mt-stroke-two 380ms ease-in-out 360ms both;
}

.mt-loading.is-drawing .mt-stroke-three {
  animation: mt-dot 260ms cubic-bezier(.34, 1.45, .5, 1) 700ms both;
}

.mt-bar {
  width: 115rpx;
  height: 5rpx;
  border-radius: 999rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.13);
}

.light .mt-bar {
  background: rgba(15, 23, 42, 0.10);
}

.mt-bar-fill {
  width: 0%;
  height: 100%;
  border-radius: 999rpx;
  background: var(--accent);
}

@keyframes mt-stroke-one {
  from {
    opacity: 0;
    transform: rotate(-49deg) scaleX(0);
  }
  to {
    opacity: 1;
    transform: rotate(-49deg) scaleX(1);
  }
}

@keyframes mt-stroke-two {
  from {
    opacity: 0;
    transform: rotate(-49deg) scaleX(0);
  }
  to {
    opacity: 1;
    transform: rotate(-49deg) scaleX(1);
  }
}

@keyframes mt-dot {
  from {
    opacity: 0;
    transform: scale(0);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

@keyframes mt-scrim-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes mt-scrim-out {
  from {
    opacity: 1;
  }
  to {
    opacity: 0;
  }
}

@keyframes mt-card-in {
  from {
    opacity: 0;
    transform: scale(0.9);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

@keyframes mt-card-out {
  from {
    opacity: 1;
    transform: scale(1);
  }
  to {
    opacity: 0;
    transform: scale(0.94);
  }
}
