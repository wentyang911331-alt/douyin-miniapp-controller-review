.app {
  min-height: 100vh;
  background: #101722;
  color: #e7ebf2;
  --bg: #101722;
  --panel: #171f2e;
  --panel-2: #202b3a;
  --border: #344158;
  --border-soft: #263246;
  --text: #e7ebf2;
  --muted: #8f9aad;
  --dim: #687385;
  --icon-dim: #687385;
  --accent: #4e67e8;
  --accent-strong: #3f57c8;
  --accent-bg: rgba(78, 103, 232, 0.16);
  --accent-text: #ffffff;
  --success: #6e788a;
  --warning: #727b8e;
  --danger: #858d9a;
  --ref-bg: rgba(104, 115, 133, 0.12);
  position: relative;
}

button {
  margin: 0;
  padding: 0;
  border: 0;
  line-height: 1;
}

button::after {
  border: 0;
}

.app.light {
  background: #f7f8fa;
  color: #1c2433;
  --bg: #f7f8fa;
  --panel: #ffffff;
  --panel-2: #f2f4f7;
  --border: #c9d1dc;
  --border-soft: #dce2ea;
  --text: #1c2433;
  --muted: #687386;
  --dim: #858d9a;
  --icon-dim: #687385;
  --accent: #3f57c8;
  --accent-strong: #3249a6;
  --accent-bg: rgba(63, 87, 200, 0.12);
  --accent-text: #ffffff;
  --success: #6e788a;
  --warning: #727b8e;
  --danger: #858d9a;
  --ref-bg: rgba(104, 115, 133, 0.08);
}

.watermark {
  position: fixed;
  left: -160rpx;
  top: 130rpx;
  width: 1160rpx;
  height: 1500rpx;
  z-index: 0;
  display: flex;
  flex-wrap: wrap;
  gap: 74rpx 104rpx;
  transform: rotate(-24deg);
  pointer-events: none;
  overflow: hidden;
}

.watermark-item {
  color: rgba(255, 255, 255, 0.055);
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1;
  white-space: nowrap;
}

.light .watermark-item {
  color: rgba(15, 23, 42, 0.06);
}

.topbar {
  position: relative;
  z-index: 2;
  padding: 20rpx 24rpx 14rpx;
  background: var(--panel);
  border-bottom: 2rpx solid var(--border);
}

.topline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 18rpx;
}

.title {
  min-width: 0;
  flex: 1;
  color: var(--text);
  font-size: 36rpx;
  font-weight: 900;
  line-height: 1.16;
}

.tool-row,
.section-actions,
.view-row,
.rank-tools {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.tool-row {
  flex-shrink: 0;
}

.icon-btn {
  width: 60rpx;
  height: 60rpx;
  min-width: 60rpx;
  border-radius: 16rpx;
  border: 2rpx solid var(--border);
  background: var(--panel-2);
  display: flex;
  align-items: center;
  justify-content: center;
}

.section-icon-btn {
  width: 54rpx;
  height: 54rpx;
  min-width: 54rpx;
  border-radius: 16rpx;
  background: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-btn.active {
  border-color: var(--accent);
  background: var(--accent-bg);
}

.section-icon-btn.active {
  background: transparent;
}

.icon-img {
  width: 40rpx;
  height: 40rpx;
}

.inline-img {
  width: 26rpx;
  height: 26rpx;
  flex-shrink: 0;
}

.section-icon-btn .icon-img {
  opacity: 0.72;
}

.icon-btn.active .icon-img,
.section-icon-btn.active .icon-img,
.sort-chip.active .inline-img {
  opacity: 1;
}

.light .icon-img,
.light .inline-img,
.light .sort-img {
  filter: brightness(0) saturate(100%) invert(38%) sepia(10%) saturate(1053%) hue-rotate(180deg) brightness(88%) contrast(86%);
}

.light .icon-btn.active .icon-img,
.light .seg-btn.active .inline-img,
.light .col-chip.on .inline-img,
.light .sort-chip.active .inline-img,
.light .modal-ok .inline-img {
  filter: none;
}

.sort-img {
  width: 24rpx;
  height: 24rpx;
  margin-left: 6rpx;
  flex-shrink: 0;
}

.nav-row,
.chip-row {
  white-space: nowrap;
  width: 100%;
}

.nav-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 128rpx;
  height: 46rpx;
  margin-right: 10rpx;
  border-radius: 14rpx;
  background: var(--panel-2);
  color: var(--text);
  font-size: 22rpx;
  font-weight: 800;
}

.nav-btn.active {
  background: var(--accent);
  color: var(--accent-text);
}

.highlight-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 12rpx 0 8rpx;
}

.highlight-label {
  color: var(--muted);
  font-size: 20rpx;
  font-weight: 800;
}

.clear-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  color: var(--muted);
  font-size: 20rpx;
}

.chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 46rpx;
  margin-right: 8rpx;
  padding: 0 18rpx;
  border-radius: 24rpx;
  border: 3rpx solid var(--border);
  background: var(--panel-2);
  color: var(--muted);
  font-size: 20rpx;
  font-weight: 800;
}

.chip.ref {
  border-style: dashed;
}

.content {
  position: relative;
  z-index: 1;
  height: calc(100vh - 250rpx);
  padding: 20rpx 20rpx 0;
  box-sizing: border-box;
}

.section {
  margin-bottom: 40rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.title-group {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.section-title {
  color: var(--text);
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.3;
}

.note {
  display: block;
  margin: 0 0 16rpx;
  color: var(--muted);
  font-size: 20rpx;
  line-height: 1.5;
}

.col-panel,
.table-card,
.rank-card {
  background: var(--panel);
  border: 2rpx solid var(--border);
  border-radius: 16rpx;
}

.col-panel {
  padding: 16rpx;
  margin-bottom: 16rpx;
}

.col-title {
  display: block;
  color: var(--muted);
  font-size: 20rpx;
  font-weight: 800;
  margin-bottom: 12rpx;
}

.col-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.col-chip,
.sort-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 42rpx;
  min-height: 42rpx;
  padding: 0 16rpx;
  border-radius: 20rpx;
  border: 2rpx solid var(--border);
  background: var(--panel-2);
  color: var(--muted);
  font-size: 20rpx;
  font-weight: 800;
  line-height: 1;
  box-sizing: border-box;
  white-space: nowrap;
}

.col-chip.on,
.sort-chip.active {
  border-color: var(--accent);
  background: var(--accent);
  color: #ffffff;
}

.view-row {
  margin-bottom: 16rpx;
  flex-wrap: wrap;
}

.seg {
  display: flex;
  padding: 4rpx;
  border: 2rpx solid var(--border);
  border-radius: 14rpx;
  background: var(--panel-2);
}

.seg-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  height: 44rpx;
  padding: 0 16rpx;
  border-radius: 10rpx;
  color: var(--muted);
  font-size: 20rpx;
  font-weight: 900;
}

.seg-btn.active {
  background: var(--accent);
  color: var(--accent-text);
}

.rank-tools {
  flex: 1;
  min-width: 0;
  flex-wrap: nowrap;
}

.rank-col-scroll {
  max-width: 300rpx;
  white-space: nowrap;
}

.sort-chip {
  margin-right: 8rpx;
}

.sort-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  height: 44rpx;
  min-width: 112rpx;
  padding: 0 14rpx;
  border-radius: 14rpx;
  border: 2rpx solid var(--border);
  background: var(--panel-2);
  color: var(--text);
  font-size: 20rpx;
  font-weight: 800;
  white-space: nowrap;
  flex-shrink: 0;
}

.hint {
  color: var(--muted);
  font-size: 18rpx;
}

.table-card {
  overflow: hidden;
  white-space: nowrap;
}

.table {
  min-width: 100%;
}

.tr {
  display: flex;
  min-height: 66rpx;
}

.th-row {
  background: var(--panel-2);
}

.cell {
  width: 210rpx;
  min-width: 210rpx;
  padding: 16rpx 18rpx;
  box-sizing: border-box;
  border-top: 2rpx solid var(--border-soft);
  color: var(--text);
  font-size: 22rpx;
  line-height: 1.25;
  white-space: nowrap;
}

.head-cell,
.model-head {
  border-top: 0;
  background: var(--panel-2);
  color: var(--muted);
  font-size: 20rpx;
  font-weight: 900;
}

.head-cell {
  display: flex;
  align-items: center;
  text-align: left;
}

.head-cell.sortable {
  color: var(--muted);
}

.head-cell.sorted {
  color: var(--accent);
}

.model-cell {
  position: sticky;
  left: 0;
  z-index: 1;
  width: 250rpx;
  min-width: 250rpx;
  border-right: 2rpx solid var(--border);
  border-left: 6rpx solid transparent;
  background: var(--panel);
  font-weight: 800;
}

.model-head {
  z-index: 2;
  background: var(--panel-2);
}

.model-cell.ref {
  border-left-style: dashed;
}

.model-inline {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
  white-space: normal;
  word-break: break-word;
}

.rank-badge,
.best-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 8rpx;
  font-weight: 900;
  line-height: 1.2;
}

.rank-badge {
  min-width: 36rpx;
  padding: 2rpx 8rpx;
  background: var(--panel-2);
  color: var(--muted);
  font-size: 18rpx;
}

.rank-badge.first,
.best-badge {
  background: var(--accent);
  color: var(--accent-text);
}

.best-badge {
  margin-left: 8rpx;
  padding: 2rpx 10rpx;
  font-size: 16rpx;
  border-radius: 12rpx;
}

.data-cell.strong {
  font-weight: 900;
}

.data-cell.long {
  white-space: normal;
  word-break: break-word;
  line-height: 1.35;
}

.good {
  color: var(--success);
}

.warn {
  color: var(--warning);
}

.bad {
  color: var(--danger);
}

.rank-card {
  padding: 20rpx;
}

.rank-item {
  padding: 14rpx 4rpx;
  border-bottom: 2rpx solid var(--border-soft);
}

.rank-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 10rpx;
}

.rank-name {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
  flex: 1;
}

.rank-number {
  width: 44rpx;
  text-align: center;
  flex-shrink: 0;
  color: var(--muted);
  font-size: 20rpx;
  font-weight: 900;
}

.rank-product {
  border-left: 6rpx solid transparent;
  padding-left: 12rpx;
  color: var(--text);
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.2;
}

.rank-value {
  color: var(--text);
  font-size: 22rpx;
  font-weight: 900;
  white-space: nowrap;
}

.bar {
  position: relative;
  height: 12rpx;
  margin-left: 60rpx;
  background: var(--panel-2);
  border-radius: 6rpx;
  overflow: visible;
}

.bar-fill {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  border-radius: 6rpx;
}

.avg-line {
  position: absolute;
  top: -4rpx;
  bottom: -4rpx;
  width: 2rpx;
  background: var(--muted);
  opacity: 0.5;
}

.avg-note {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 12rpx;
  padding-left: 60rpx;
  color: var(--dim);
  font-size: 18rpx;
}

.avg-mark {
  width: 20rpx;
  height: 2rpx;
  background: var(--muted);
  opacity: 0.5;
}

.ref-block {
  margin-top: 12rpx;
  padding: 14rpx 4rpx 0;
  border-top: 4rpx dashed var(--border);
  opacity: 0.85;
}

.ref-label {
  display: block;
  margin: 0 0 8rpx 60rpx;
  color: var(--dim);
  font-size: 18rpx;
}

.ref-product {
  color: var(--muted);
  border-left-style: dashed;
  border-left-color: var(--dim);
}

.ref-value {
  color: var(--muted);
}

.ref-fill {
  background: var(--dim);
  opacity: 0.65;
}

.footer {
  margin: 36rpx 0 40rpx;
  padding: 20rpx;
  color: var(--dim);
  font-size: 20rpx;
  line-height: 1.6;
  text-align: center;
}

.modal-layer {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx 28rpx;
  box-sizing: border-box;
}

.modal-backdrop {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(4, 8, 16, 0.72);
}

.light .modal-backdrop {
  background: rgba(16, 23, 34, 0.42);
}

.info-modal {
  position: relative;
  z-index: 1;
  width: 100%;
  max-width: 668rpx;
  max-height: 78vh;
  padding: 28rpx;
  border: 2rpx solid var(--border);
  border-radius: 24rpx;
  background: var(--panel);
  box-shadow: 0 34rpx 96rpx rgba(0, 0, 0, 0.34);
  box-sizing: border-box;
}

.info-modal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding-bottom: 18rpx;
  border-bottom: 2rpx solid var(--border-soft);
}

.info-modal-title {
  color: var(--text);
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.25;
}

.modal-close {
  width: 56rpx;
  height: 56rpx;
  min-width: 56rpx;
  border-radius: 16rpx;
  border: 2rpx solid var(--border);
  background: var(--panel-2);
  display: flex;
  align-items: center;
  justify-content: center;
}

.info-modal-body {
  max-height: 48vh;
  padding: 20rpx 0 8rpx;
}

.info-intro,
.info-note {
  display: block;
  color: var(--muted);
  font-size: 22rpx;
  line-height: 1.65;
}

.info-intro {
  margin-bottom: 16rpx;
}

.info-point {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-bottom: 14rpx;
}

.info-dot {
  width: 10rpx;
  height: 10rpx;
  margin-top: 14rpx;
  border-radius: 999rpx;
  background: var(--accent);
  flex-shrink: 0;
}

.info-point-text {
  flex: 1;
  min-width: 0;
  color: var(--text);
  font-size: 22rpx;
  line-height: 1.65;
}

.info-note {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid var(--border-soft);
}

.modal-ok {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 220rpx;
  height: 58rpx;
  margin: 20rpx auto 0;
  border-radius: 999rpx;
  background: var(--accent);
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 1;
}
