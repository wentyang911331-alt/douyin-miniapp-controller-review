page {
  min-height: 100%;
  background: #0E1623;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  letter-spacing: 0;
}

button {
  padding: 0;
  margin: 0;
  line-height: 1;
  background: transparent;
  color: inherit;
  font-family: inherit;
}

button::after {
  border: 0;
}
